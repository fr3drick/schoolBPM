PORT=4000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/schoolbpm
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=1d

# Used for deep links in notification and password-reset emails
APP_BASE_URL=http://localhost:4200

# How long a password reset link stays valid
PASSWORD_RESET_TTL_MINUTES=45

# Self-onboarding: how long the six-digit signup code lasts, how many wrong
# guesses burn it, and how long a verified applicant has to finish the school
# details step before having to verify again.
SIGNUP_OTP_TTL_MINUTES=60
SIGNUP_OTP_MAX_ATTEMPTS=6
SIGNUP_TOKEN_TTL_MINUTES=120

# Set behind a proxy/load balancer (e.g. 1) so req.ip is the real client —
# rate limits are keyed on it. Leave unset when the API is directly exposed.
TRUST_PROXY=

# Email delivery: console | smtp | resend
#   console  logs a summary, sends nothing (default)
#   smtp     local Mailpit, or any SMTP provider
#   resend   production
MAIL_PROVIDER=console
MAIL_FROM="School BPM <notifications@yourdomain.com>"

# MAIL_PROVIDER=smtp  (Mailpit: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# MAIL_PROVIDER=resend
RESEND_API_KEY=

# Outbox worker tuning (optional)
MAIL_WORKER_ENABLED=true
MAIL_POLL_MS=15000
MAIL_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=5
